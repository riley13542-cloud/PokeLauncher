<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PokeLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="680"
        x:Class="PokeLauncher.Views.ControlsDialog"
        x:DataType="vm:ControlsDialogViewModel"
        Title="{Binding HeaderText}"
        Width="520" Height="680" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" CanResize="True"
        Background="{DynamicResource BgBaseBrush}"
        FontFamily="fonts:Inter#Inter,Segoe UI">

    <Grid Margin="22" RowDefinitions="Auto,*,Auto,Auto,Auto">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Text="Click a button below, then press the keyboard key you want for it. Changes are saved to the emulator's own configuration file (a backup is made first)."
                       Classes="secondary" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Buttons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ControlButtonRow">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource SubtleBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ButtonLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12"
                                        Command="{Binding $parent[ItemsControl].((vm:ControlsDialogViewModel)DataContext).ArmRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding !IsAssigning}"
                                        AutomationProperties.Name="Assign key">
                                    <TextBlock Text="{Binding Display}"/>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                                           IsVisible="{Binding IsAssigning}"/>
                                <TextBlock Grid.Column="2" Text="press any key…" Classes="tertiary" FontSize="11.5" VerticalAlignment="Center"
                                           IsVisible="{Binding IsAssigning}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0">
            <Button Theme="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12"
                    Command="{Binding ClearAllCommand}"
                    AutomationProperties.Name="Clear all key assignments">Clear all assignments</Button>
        </StackPanel>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
            <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}" Content="Cancel" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Theme="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                    AutomationProperties.Name="Save keyboard controls">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Save controls" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="4" Text="Tip: press Esc while assigning to cancel that assignment."
                   Classes="tertiary" FontSize="11" Margin="0,8,0,0"/>
    </Grid>
</Window>

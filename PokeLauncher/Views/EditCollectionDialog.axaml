<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PokeLauncher.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="720"
        x:Class="PokeLauncher.Views.EditCollectionDialog"
        x:DataType="vm:EditCollectionDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="600" Height="720" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" CanResize="True"
        Background="{DynamicResource BgBaseBrush}"
        FontFamily="fonts:Inter#Inter,Segoe UI">

    <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Text="{Binding DialogTitle}" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="Collections group games across your library; a game can live in any number of them. Changes are saved to your local library."
                       Classes="secondary" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10">
            <StackPanel Spacing="6">
                <TextBlock Text="Name" Classes="group-label"/>
                <TextBox Text="{Binding Name, Mode=TwoWay}" MinHeight="36" VerticalContentAlignment="Center"
                         PlaceholderText="e.g. Johto replay queue"
                         AutomationProperties.Name="Collection name"/>
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Description" Classes="group-label"/>
                <TextBox Text="{Binding Description, Mode=TwoWay}" MinHeight="64"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         AutomationProperties.Name="Collection description"/>
            </StackPanel>
        </StackPanel>

        <!-- Member editor -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,14,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Games in this collection" Classes="group-label" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Theme="{StaticResource SearchTextBox}" Width="200"
                         Text="{Binding MemberFilter, Mode=TwoWay}"
                         PlaceholderText="Filter games…"
                         AutomationProperties.Name="Filter member list"/>
            </Grid>
        </StackPanel>
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="6">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding VisibleMembers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CollectionMemberRowViewModel">
                            <CheckBox IsChecked="{Binding IsMember, Mode=TwoWay}" Padding="8,6"
                                      AutomationProperties.Name="{Binding Title}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MetaLine}" Classes="tertiary" FontSize="11.5"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Danger zone: delete (edit mode only) -->
        <Border Grid.Row="4" Classes="info-strip" Margin="0,12,0,0" IsVisible="{Binding !IsCreate}">
            <StackPanel Spacing="8">
                <TextBlock Text="Deleting a collection removes it and its membership — the games themselves stay in your library."
                           Classes="tertiary" TextWrapping="Wrap"/>
                <Button Theme="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleDeleteCommand}"
                        AutomationProperties.Name="Delete collection">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DeleteButtonLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}" Content="Cancel" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Theme="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                    AutomationProperties.Name="Save collection">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Save collection" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>

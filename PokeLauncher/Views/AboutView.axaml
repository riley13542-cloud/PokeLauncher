<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokeLauncher.ViewModels"
             xmlns:controls="using:PokeLauncher.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="PokeLauncher.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="18" MaxWidth="680" HorizontalAlignment="Left">

            <Border Classes="card" Padding="24">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="{Binding BrandLogo}" Width="52" Height="52"/>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding AppName}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Classes="chip accent" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Tagline}" Classes="secondary" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ItemsControl ItemsSource="{Binding TechStack}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="24">
                <StackPanel Spacing="10">
                    <TextBlock Text="What's new in this release" Classes="section-title"/>
                    <ItemsControl ItemsSource="{Binding WhatsNew}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="24">
                <StackPanel Spacing="10">
                    <TextBlock Text="Feature status" Classes="section-title"/>
                    <ItemsControl ItemsSource="{Binding Statuses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AboutStatusItem">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4">
                                    <Panel Width="18">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsDone}"/>
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource MediumBrush}" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsDone}"/>
                                    </Panel>
                                    <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Done items are implemented in this milestone; the rest are planned for later phases."
                               Classes="tertiary"/>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="24">
                <StackPanel Spacing="10">
                    <TextBlock Text="Updates" Classes="section-title"/>
                    <TextBlock Text="PokeLauncher can check an update source for a newer version, download the official installer, and verify it by SHA-256 before you run it. It never installs anything on its own — you always confirm."
                               Classes="secondary" FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Theme="{StaticResource PrimaryButton}" Padding="14,7"
                                Command="{Binding CheckForUpdateCommand}"
                                IsEnabled="{Binding !IsCheckingForUpdate}"
                                AutomationProperties.Name="Check for updates">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Check for updates" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Theme="{StaticResource PrimaryButton}" Padding="14,7"
                                Command="{Binding InstallUpdateNowCommand}"
                                IsVisible="{Binding IsInstallerReady}"
                                AutomationProperties.Name="Install the downloaded update now (closes PokeLauncher)">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Install update now (closes PokeLauncher)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Theme="{StaticResource SecondaryButton}" Padding="14,7"
                                Command="{Binding DownloadUpdateCommand}"
                                IsVisible="{Binding PendingUpdateMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                AutomationProperties.Name="Download the update">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Download update" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatus}" Classes="secondary" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding UpdateStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding PendingUpdateMessage}" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding PendingUpdateMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="No update source is configured for this copy yet — see notes.md (UpdateService) for how distributors set one up."
                               Classes="tertiary" FontSize="11.5" TextWrapping="Wrap"
                               IsVisible="{Binding UpdatesConfigured, Converter={x:Static conv:BoolConverters.Not}}"/>
                </StackPanel>
            </Border>

            <Border Classes="info-strip">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource MediumBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

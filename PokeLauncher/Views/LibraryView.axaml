<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokeLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="PokeLauncher.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <DockPanel Margin="{StaticResource PagePadding}">

        <!-- Header + toolbar -->
        <StackPanel DockPanel.Dock="Top" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="My Library" Classes="page-title"/>
                    <TextBlock Text="{Binding CountLabel}" Classes="secondary" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Theme="{StaticResource SecondaryButton}"
                            Command="{Binding ImportFromFolderCommand}"
                            AutomationProperties.Name="Import all games from a folder"
                            ToolTip.Tip="Pick a folder of game files - PokeLauncher matches them against your library and attaches everything in one step. Files stay where they are.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Import from folder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Theme="{StaticResource SecondaryButton}"
                            Command="{Binding CheckInboxCommand}"
                            AutomationProperties.Name="Check the ROM inbox"
                            ToolTip.Tip="Match game files you dropped into the managed ROM inbox against your library.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Check ROM inbox" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Theme="{StaticResource PrimaryButton}"
                            Command="{Binding ImportGamesCommand}"
                            AutomationProperties.Name="Import Games">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Import Games" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Classes="info-strip" IsVisible="{Binding HasStatusMessage}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Theme="{StaticResource GhostIconButton}"
                            Content="&#xE711;" Margin="8,0,0,0"
                            AutomationProperties.Name="Dismiss message"
                            Command="{Binding ClearStatusCommand}"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox Theme="{StaticResource FilterComboBox}"
                          ItemsSource="{Binding GenerationOptions}"
                          SelectedItem="{Binding SelectedGeneration, Mode=TwoWay}"
                          AutomationProperties.Name="Filter by generation">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GenOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Theme="{StaticResource FilterComboBox}"
                          ItemsSource="{Binding PlatformOptions}"
                          SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                          AutomationProperties.Name="Filter by platform"/>
                <ComboBox Theme="{StaticResource FilterComboBox}" MinWidth="170"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                          AutomationProperties.Name="Sort games">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibrarySortOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ToggleButton Theme="{StaticResource ChipToggleButton}"
                              IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"
                              AutomationProperties.Name="Favorites only">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Favorites only" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Theme="{StaticResource ChipToggleButton}"
                              IsChecked="{Binding MissingRomsOnly, Mode=TwoWay}"
                              AutomationProperties.Name="Missing ROMs only"
                              ToolTip.Tip="Show built-in games that don't have a ROM file attached yet.">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Missing ROMs" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <RadioButton Theme="{StaticResource IconToggleRadioButton}" GroupName="LibraryViewMode"
                             Content="&#xE71D;"
                             IsChecked="{Binding IsGridView, Mode=TwoWay}"
                             AutomationProperties.Name="Grid view"/>
                <RadioButton Theme="{StaticResource IconToggleRadioButton}" GroupName="LibraryViewMode"
                             Content="&#xEA37;"
                             IsChecked="{Binding !IsGridView, Mode=TwoWay}"
                             AutomationProperties.Name="List view"/>
                <Button Theme="{StaticResource SecondaryButton}" Command="{Binding ClearFiltersCommand}"
                        Content="Clear filters" Padding="12,6" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Results -->
        <Panel Margin="0,16,0,0">
            <!-- Grid view -->
            <ScrollViewer IsVisible="{Binding IsGridView}" IsEnabled="{Binding IsGridView}">
                <ItemsControl ItemsSource="{Binding FilteredGames}"
                              ItemTemplate="{StaticResource GameCardTemplate}"
                              IsVisible="{Binding HasResults}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <!-- List view -->
            <ScrollViewer IsVisible="{Binding !IsGridView}" IsEnabled="{Binding !IsGridView}">
                <ItemsControl ItemsSource="{Binding FilteredGames}"
                              ItemTemplate="{StaticResource GameRowTemplate}"
                              IsVisible="{Binding HasResults}" Margin="0,0,0,8"/>
            </ScrollViewer>
            <!-- Empty state -->
            <Border Classes="card" IsVisible="{Binding !HasResults}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="No games match the current filters" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try a different search term, or clear the filters to see the full catalog."
                               Classes="secondary" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>
</UserControl>

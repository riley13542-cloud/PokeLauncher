<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokeLauncher.ViewModels"
             xmlns:controls="using:PokeLauncher.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
             x:Class="PokeLauncher.Views.RomHackDetailsView"
             x:DataType="vm:RomHackDetailsViewModel">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel IsVisible="{Binding HasHack}" Spacing="18" MaxWidth="860" HorizontalAlignment="Left">

            <!-- Banner -->
            <Border Classes="card" Padding="0" CornerRadius="16" Height="240" ClipToBounds="True">
                <Panel>
                    <controls:CoverPlaceholder
                        FromColor="{Binding Hack.CoverFrom}"
                        ToColor="{Binding Hack.CoverTo}"
                        ShowText="False" BallSize="150" BallOpacity="0.45"/>
                    <Border Background="{DynamicResource HeroOverlayBrush}"/>
                    <StackPanel Margin="28" VerticalAlignment="Center" Spacing="10" HorizontalAlignment="Left">
                        <Border Classes="chip accent" HorizontalAlignment="Left">
                            <TextBlock Text="ROM Hack"/>
                        </Border>
                        <TextBlock Text="{Binding Hack.Title}" FontSize="30" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding Hack.Creator, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Hack.Creator}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MetaLine}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ToggleButton Theme="{StaticResource StarToggleButton}"
                                          IsChecked="{Binding Hack.IsBookmarked, Mode=TwoWay}"
                                          AutomationProperties.Name="Bookmark"/>
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </Border>

            <!-- Tags -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="chip"
                        Classes.easy="{Binding Hack.IsEasy}"
                        Classes.medium="{Binding Hack.IsMedium}"
                        Classes.hard="{Binding Hack.IsHard}"
                        Classes.very-hard="{Binding Hack.IsVeryHard}">
                    <TextBlock Text="{Binding Hack.Difficulty}"/>
                </Border>
                <Border Classes="chip"><TextBlock Text="{Binding Hack.Genre}"/></Border>
                <Border Classes="chip"
                        Classes.complete="{Binding Hack.IsComplete}"
                        Classes.beta="{Binding Hack.IsBeta}"
                        Classes.wip="{Binding Hack.IsWip}"
                        Classes.discontinued="{Binding Hack.IsDiscontinued}">
                    <TextBlock Text="{Binding Hack.Status}"/>
                </Border>
                <Border Classes="chip"><TextBlock Text="{Binding GenerationLabel}"/></Border>
                <Border Classes="chip" Classes.ok="{Binding Hack.HasHealthyRom}">
                    <TextBlock Text="{Binding Hack.RomFileStatus}"/>
                </Border>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Theme="{StaticResource PrimaryButton}"
                        Command="{Binding PlayCommand}"
                        IsVisible="{Binding Hack.HasRom}"
                        IsEnabled="{Binding !Hack.IsRunning}"
                        AutomationProperties.Name="Play this hack">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                   FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Hack.PlayButtonLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Theme="{StaticResource PrimaryButton}"
                        Command="{Binding EditDetailsCommand}"
                        IsVisible="{Binding !Hack.HasRom}"
                        AutomationProperties.Name="Attach a patched ROM">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource IconFont}"
                                   FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Attach patched ROM…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Theme="{StaticResource SecondaryButton}"
                        Command="{Binding EditDetailsCommand}"
                        AutomationProperties.Name="Edit hack details">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit details" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Launch failure / missing ROM strips -->
            <Border Classes="info-strip" MaxWidth="560" HorizontalAlignment="Left"
                    BorderBrush="{DynamicResource MediumBrush}"
                    IsVisible="{Binding HasLaunchError}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource MediumBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LaunchError}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="420"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Theme="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12"
                                Command="{Binding OpenEmulatorSettingsCommand}"
                                IsVisible="{Binding LaunchErrorNeedsEmulator}"
                                AutomationProperties.Name="Open emulator settings">
                            Open Settings
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Description -->
            <StackPanel Spacing="8">
                <TextBlock Text="About this hack" Classes="section-title"/>
                <TextBlock Text="{Binding Hack.Description}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Technical info -->
            <StackPanel Spacing="8">
                <TextBlock Text="Details" Classes="section-title"/>
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" MaxWidth="760"
                      HorizontalAlignment="Left">
                    <TextBlock Text="Base game" Classes="secondary" FontSize="12" Margin="0,4"/>
                    <TextBlock Grid.Column="1" Text="{Binding BaseGameTitle}" FontSize="12" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Patched ROM" Classes="secondary" FontSize="12" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hack.RomFileStatus}" FontSize="12" Margin="0,4"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Hack.RomPath}"/>
                    <TextBlock Grid.Row="2" Text="Official page" Classes="secondary" FontSize="12" Margin="0,4"
                               IsVisible="{Binding Hack.HasExternalUrl}"/>
                    <Button Grid.Row="2" Grid.Column="1" Theme="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12"
                            Command="{Binding OpenExternalPageCommand}" HorizontalAlignment="Left" Margin="0,2"
                            IsVisible="{Binding Hack.HasExternalUrl}"
                            AutomationProperties.Name="Open the hack's official page (external)">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Open in browser (external)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <Border Classes="info-strip" MaxWidth="760" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="The playable file is your own patched ROM — PokeLauncher launches it through the base game's emulator and never downloads or patches hacks for you."
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

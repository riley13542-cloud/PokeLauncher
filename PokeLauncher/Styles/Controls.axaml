<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== Buttons ============================== -->

    <ControlTheme x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{DynamicResource AccentGradientBrush}"
                        CornerRadius="10" Padding="18,10"
                        BoxShadow="0 6 18 0 #40000000">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#Root">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Opacity" Value="0.92"/>
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="RenderTransform" Value="scale(0.985)"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#Root">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,9">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#Root">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#Root">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="GhostIconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root" Background="Transparent" CornerRadius="8" Width="36" Height="36">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#Root">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="CardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1" CornerRadius="12"
                        BoxShadow="0 2 8 0 #1A000000">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#Root">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
                    <BrushTransition Property="Background" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BoxShadow" Value="0 10 24 0 #4D000000"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
    </ControlTheme>

    <!-- ============================ Navigation ============================= -->

    <ControlTheme x:Key="SidebarNavRadioButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root" Background="Transparent"
                        BorderBrush="Transparent" BorderThickness="1"
                        CornerRadius="9" Margin="10,2" Padding="12,9">
                    <Grid ColumnDefinitions="3,*">
                        <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2"
                                Background="Transparent" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="{StaticResource IconFont}" FontSize="15"
                                       VerticalAlignment="Center"/>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              FontSize="13" FontWeight="Medium"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#Root">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="^:checked /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        </Style>
        <Style Selector="^:checked /template/ Border#Indicator">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="IconToggleRadioButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root" Background="Transparent"
                        BorderBrush="Transparent" BorderThickness="1"
                        CornerRadius="8" Width="36" Height="36">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="^:checked /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        </Style>
    </ControlTheme>

    <!-- ============================ Small toggles ========================== -->

    <ControlTheme x:Key="StarToggleButton" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root" Width="30" Height="30" CornerRadius="15"
                        Background="#B314141B" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Panel>
                        <TextBlock x:Name="Outline" Text="&#xE735;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Filled" Text="&#xE734;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource StarBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ TextBlock#Filled">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^:checked /template/ TextBlock#Filled">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="^:checked /template/ TextBlock#Outline">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource StarBrush}"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ChipToggleButton" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1" CornerRadius="999" Padding="13,7">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#Root">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="^:checked /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        </Style>
    </ControlTheme>

    <!-- ============================== Inputs =============================== -->

    <ControlTheme x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </ControlTheme>

    <ControlTheme x:Key="FilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="150"/>
    </ControlTheme>
</ResourceDictionary>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PokeLauncher.App"
             xmlns:local="using:PokeLauncher"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PokeLauncher/Styles/Tokens.axaml"/>
                <ResourceInclude Source="avares://PokeLauncher/Styles/Controls.axaml"/>
                <ResourceInclude Source="avares://PokeLauncher/Styles/Cards.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PokeLauncher/Styles/ClassStyles.axaml"/>
    </Application.Styles>
</Application>
